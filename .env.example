# ---------- llama.cpp Server ----------
# Image: CPU = ghcr.io/ggml-org/llama.cpp:server | NVIDIA = ghcr.io/ggml-org/llama.cpp:server-cuda
LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server
LLAMA_PORT=8065
LLAMA_CTX_SIZE=8192
LLAMA_N_GPU_LAYERS=0
LLAMA_PARALLEL=2
LLAMA_CONT_BATCHING=on
LLAMA_FLASH_ATTN=auto
# API-Key fuer die OpenAI-kompatible API (Clients muessen 'Authorization: Bearer <key>' senden)
LLAMA_API_KEY=<DEIN-LLAMA-API-KEY>

# ---------- Admin-WebUI ----------
ADMIN_IMAGE=ghcr.io/jbkunama1/hai.llama.cppportainer:latest
ADMIN_PORT=8066
# Key fuer die Admin-Oberflaeche (wird im Browser eingegeben, Header X-Admin-Key)
ADMIN_API_KEY=<DEIN-ADMIN-API-KEY>
# true = Admin darf llamacpp-Container nach Modellwechsel via Docker-Socket neu starten
RESTART_VIA_DOCKER=true
LLAMA_CONTAINER_NAME=llamacpp

# ---------- Netzwerk ----------
# z. B. highfishNetwork, wenn der Stack in deinem bestehenden Netz laufen soll
DOCKER_NETWORK=llamanet
